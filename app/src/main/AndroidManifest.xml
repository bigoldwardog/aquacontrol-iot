<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AquaControlIoT">

        <!-- Pantalla de Bienvenida (Principal) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AquaControlIoT"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Inicio de Sesión -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:label="@string/login_title"
            android:theme="@style/Theme.AquaControlIoT"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de Selección de Rol -->
        <activity
            android:name=".auth.RoleSelectionActivity"
            android:exported="false"
            android:label="@string/role_title"
            android:theme="@style/Theme.AquaControlIoT" />

        <!-- Pantalla Provisional Monitor -->
        <activity
            android:name=".dashboard.MonitorProvisionalActivity"
            android:exported="false"
            android:label="@string/monitor_title"
            android:theme="@style/Theme.AquaControlIoT" />

        <!-- Pantalla Provisional Controlador -->
        <activity
            android:name=".simulator.ControllerProvisionalActivity"
            android:exported="false"
            android:label="@string/controller_title"
            android:theme="@style/Theme.AquaControlIoT" />

    </application>

</manifest>